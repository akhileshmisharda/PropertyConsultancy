<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvProfile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="100dp">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/registerProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Header Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                app:layout_constraintTop_toBottomOf="@id/registerProgress">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvProfileContainer"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ivProfile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_app_logo" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:id="@+id/llNameFields"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@id/cvProfileContainer"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cvProfileContainer"
                    app:layout_constraintTop_toTopOf="@id/cvProfileContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/etFirstName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="First Name"
                            style="@style/App.EditText.Style"
                            android:background="@null"
                            android:padding="2dp"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <ImageButton
                            android:id="@+id/btnMicFirstName"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_mic"
                            app:tint="?attr/colorPrimary"
                            android:contentDescription="@string/voice_input_description" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="4dp"
                        android:background="?attr/colorOutline"
                        android:alpha="0.2" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/etLastName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Last Name"
                            style="@style/App.EditText.Style"
                            android:background="@null"
                            android:padding="2dp"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <ImageButton
                            android:id="@+id/btnMicLastName"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_mic"
                            app:tint="?attr/colorPrimary"
                            android:contentDescription="@string/voice_input_description" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llProfileCompletion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:id="@+id/tvCompletionLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Profile Completion: 0%"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary" />
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/pbCompletion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            app:indicatorColor="?attr/colorPrimary"
                            app:trackColor="#E0E0E0"
                            app:trackThickness="4dp"
                            app:trackCornerRadius="2dp"
                            android:progress="0" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <ImageView
                        android:id="@+id/ivStatus"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_tick"
                        app:tint="?attr/colorPrimary" />
                    <TextView
                        android:id="@+id/tvActiveStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Active Member"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvContactInfoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:text="Contact Details"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/clHeader" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cvContactInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvContactInfoLabel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/etPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Mobile Number"
                            android:inputType="phone"
                            style="@style/App.EditText.Style"
                            android:background="@null"
                            android:padding="4dp" />
                        <ImageButton
                            android:id="@+id/btnMicPhone"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_mic"
                            app:tint="?attr/colorPrimary"
                            android:contentDescription="@string/voice_input_description" />
                        <LinearLayout
                            android:id="@+id/llVerified"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="8dp">
                            <ImageView
                                android:id="@+id/ivVerified"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_tick"
                                app:tint="?attr/colorPrimary" />
                            <TextView
                                android:id="@+id/tvVerifiedStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Verify"
                                android:textColor="?attr/colorPrimary"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- OTP Verification Section (Inline) -->
                    <LinearLayout
                        android:id="@+id/layoutOtp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingTop="8dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="8dp"
                            android:background="?attr/colorOutline"
                            android:alpha="0.2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verify your number"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <EditText
                                android:id="@+id/etOtp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="6-digit OTP"
                                android:inputType="number"
                                android:maxLength="6"
                                style="@style/App.EditText.Style"
                                android:background="@null"
                                android:letterSpacing="0.2" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnVerifyOtp"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Verify"
                                android:textSize="12sp"
                                app:cornerRadius="8dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">
                            <TextView
                                android:id="@+id/tvOtpCountdown"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Resend in 60s"
                                android:textSize="11sp"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                            <TextView
                                android:id="@+id/btnResendOtp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Resend SMS"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"
                                android:visibility="gone"
                                android:padding="8dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="?attr/colorOutline"
                        android:alpha="0.2" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/etEmail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Email Address"
                            android:inputType="textEmailAddress"
                            style="@style/App.EditText.Style"
                            android:background="@null"
                            android:padding="4dp" />
                        <ImageButton
                            android:id="@+id/btnMicEmail"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_mic"
                            app:tint="?attr/colorPrimary"
                            android:contentDescription="@string/voice_input_description" />
                        <LinearLayout
                            android:id="@+id/llVerifiedEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="8dp">
                            <ImageView
                                android:id="@+id/ivVerifiedEmail"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_tick"
                                app:tint="?attr/colorPrimary" />
                            <TextView
                                android:id="@+id/tvVerifiedStatusEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Verify"
                                android:textColor="?attr/colorPrimary"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Address Section -->
            <TextView
                android:id="@+id/tvAddressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:text="Address Details"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cvContactInfo" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvAddressLabel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <EditText
                        android:id="@+id/etAddressLine1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Street Address"
                        style="@style/App.EditText.Style"
                        android:background="@null"
                        android:padding="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="?attr/colorOutline"
                        android:alpha="0.2" />

                    <EditText
                        android:id="@+id/etAddressLine2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/apt_suite_hint"
                        style="@style/App.EditText.Style"
                        android:background="@null"
                        android:padding="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="?attr/colorOutline"
                        android:alpha="0.2" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/etCity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="City"
                            style="@style/App.EditText.Style"
                            android:background="@null"
                            android:padding="4dp" />
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="?attr/colorOutline"
                            android:alpha="0.2" />
                        <EditText
                            android:id="@+id/etState"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="State"
                            style="@style/App.EditText.Style"
                            android:background="@null"
                            android:padding="4dp" />
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="?attr/colorOutline"
                            android:alpha="0.2" />
                        <EditText
                            android:id="@+id/etZipCode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Zip"
                            android:inputType="number"
                            style="@style/App.EditText.Style"
                            android:background="@null"
                            android:padding="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="bottom">
                        <TextView
                            android:id="@+id/tvPinOnMap"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pin your location"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary" />
                        <TextView
                            android:id="@+id/tvCoordsDisplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.000000, 0.000000"
                            android:textSize="10sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/mapCard"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginTop="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp">
                        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                            <androidx.fragment.app.FragmentContainerView
                                android:id="@+id/mapProfile"
                                android:name="com.google.android.gms.maps.SupportMapFragment"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <View
                                android:id="@+id/mapOverlay"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#11000000" />

                            <TextView
                                android:id="@+id/tvMapInstruction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|center_horizontal"
                                android:layout_marginBottom="12dp"
                                android:background="#88000000"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="Double tap to enable map"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp" />

                            <!-- Custom Zoom Controls in Top Corner -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:layout_margin="12dp"
                                android:orientation="vertical"
                                android:elevation="4dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnZoomInProfile"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:padding="0dp"
                                    android:text="+"
                                    android:textSize="20sp"
                                    app:cornerRadius="8dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnZoomOutProfile"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_marginTop="4dp"
                                    android:padding="0dp"
                                    android:text="-"
                                    android:textSize="20sp"
                                    app:cornerRadius="8dp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:layout_marginBottom="12dp"
                                android:src="@drawable/ic_location_pin"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Security Section -->
            <TextView
                android:id="@+id/tvSecurityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:text="Security"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cvAddress" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cvSecurity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvSecurityLabel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/btnChangePasswordToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="Change Password"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        android:drawableEnd="@drawable/ic_back"
                        android:rotationY="180"
                        app:drawableTint="?attr/colorPrimary" />

                    <LinearLayout
                        android:id="@+id/layoutPasswordChange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingTop="8dp">

                        <EditText
                            android:id="@+id/etNewPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="New Password"
                            android:inputType="textPassword"
                            style="@style/App.EditText.Style"
                            android:padding="4dp"
                            android:background="@null" />

                        <EditText
                            android:id="@+id/etRepeatPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Repeat Password"
                            android:inputType="textPassword"
                            style="@style/App.EditText.Style"
                            android:padding="4dp"
                            android:background="@null" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Assigned Executive Section -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardExecutive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="?android:attr/windowBackground"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/cvSecurity"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ASSIGNED EXECUTIVE"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        android:letterSpacing="0.1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivExecutiveImage"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_profile_modern"
                            android:scaleType="centerCrop"
                            app:strokeWidth="2dp"
                            app:strokeColor="?attr/colorPrimary"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:id="@+id/tvExecutiveName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="John Doe" />

                            <TextView
                                android:id="@+id/tvExecutiveMobile"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="14sp"
                                tools:text="+91 9876543210" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCallExecutive"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Call"
                            android:textSize="12sp"
                            app:cornerRadius="8dp" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/llAccountSinceContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardExecutive">
                <TextView
                    android:id="@+id/tvAccountSince"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Member since Jan 2024"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Hidden UI Elements (Maintaining IDs) -->
            <ImageView android:id="@+id/btnBack" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:ignore="MissingConstraints" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnUpdate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:layout_gravity="bottom|end"
        android:text="Save Changes"
        app:icon="@drawable/ic_tick"
        style="@style/App.Button.Style"
        app:elevation="8dp" />

</FrameLayout>
