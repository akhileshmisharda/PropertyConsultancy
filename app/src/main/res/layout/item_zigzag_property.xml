<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="16dp"
    android:minHeight="190dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Content for Left Image (Type A) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutLeft"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:id="@+id/bgCardLeft"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="60dp"
            android:background="@drawable/bg_zigzag_card"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPropertyTypeLeft"
            style="@style/App.BhkTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:textSize="12sp"
            android:textColor="#E53935"
            android:layout_marginBottom="6dp"
            app:layout_constraintBottom_toTopOf="@id/cardImageLeft"
            app:layout_constraintStart_toStartOf="@id/cardImageLeft"
            app:layout_constraintEnd_toEndOf="@id/cardImageLeft"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="APARTMENT" />

        <ImageView
            android:id="@+id/ivFilterProTypeLeft"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_filter_indicator"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/tvPropertyTypeLeft"
            app:layout_constraintStart_toEndOf="@id/tvPropertyTypeLeft"
            android:layout_marginStart="2dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardImageLeft"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="65dp"
            app:cardElevation="10dp"
            app:cardMaxElevation="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorPrimary"
            app:layout_constraintBottom_toTopOf="@id/llMediaLeft"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPropertyTypeLeft">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/ivPropertyLeft"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:transitionName="property_image"
                    tools:src="@drawable/ic_app_logo" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/llMediaLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/cardImageLeft"
            app:layout_constraintStart_toStartOf="@id/cardImageLeft"
            app:layout_constraintEnd_toEndOf="@id/cardImageLeft"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvImgCountLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="•••"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivVideoIconLeft"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@android:drawable/ic_menu_slideshow"
                app:tint="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="142dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/ivFilterPriceLeft"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/ic_filter_indicator"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/tvPriceLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="start"
                        tools:text="₹ 28,000" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvTitleLeft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="#37474F"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:transitionName="property_title"
                    tools:text="SKYLINE APARTMENT" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvInterestedLeft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="12 Interested"
                    android:textColor="#546E7A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="start" />
                <TextView
                    android:id="@+id/tvAmenitiesLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#546E7A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    tools:text="12 Amenities" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvBathLeft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#616161"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    tools:text="2 BathRoom" />
                <TextView
                    android:id="@+id/tvAreaLeft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#616161"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    tools:text="1300 Sqft" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvLocationLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:gravity="center"
                    android:textColor="#757575"
                    android:textSize="11sp"
                    tools:text="Model Town" />
                <ImageView
                    android:id="@+id/ivFilterLocationLeft"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_filter_indicator"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvFacingLeft"
                    style="@style/App.BhkTag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    tools:text="East" />

                <Space android:layout_width="4dp" android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvRoadSizeLeft"
                    style="@style/App.BhkTag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    tools:text="40ft" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/ivFilterBhkLeft"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/ic_filter_indicator"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/tvBhkLeft"
                        style="@style/App.BhkTag"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        tools:text="2 BHK" />
                </LinearLayout>

                <Space android:layout_width="4dp" android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvFurnishedLeft"
                    style="@style/App.BhkTag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    tools:text="Furnished" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content for Right Image (Type B) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutRight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible">

        <View
            android:id="@+id/bgCardRight"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="60dp"
            android:background="@drawable/bg_zigzag_card_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPropertyTypeRight"
            style="@style/App.BhkTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:textSize="12sp"
            android:textColor="#E53935"
            android:layout_marginBottom="6dp"
            app:layout_constraintBottom_toTopOf="@id/cardImageRight"
            app:layout_constraintEnd_toEndOf="@id/cardImageRight"
            app:layout_constraintStart_toStartOf="@id/cardImageRight"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="VILLA" />

        <ImageView
            android:id="@+id/ivFilterProTypeRight"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_filter_indicator"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/tvPropertyTypeRight"
            app:layout_constraintEnd_toStartOf="@id/tvPropertyTypeRight"
            android:layout_marginEnd="2dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardImageRight"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="65dp"
            app:cardElevation="10dp"
            app:cardMaxElevation="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorPrimary"
            app:layout_constraintBottom_toTopOf="@id/llMediaRight"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPropertyTypeRight">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/ivPropertyRight"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:transitionName="property_image"
                    tools:src="@drawable/ic_app_logo" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/llMediaRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/cardImageRight"
            app:layout_constraintStart_toStartOf="@id/cardImageRight"
            app:layout_constraintEnd_toEndOf="@id/cardImageRight"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvImgCountRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="•••"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivVideoIconRight"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@android:drawable/ic_menu_slideshow"
                app:tint="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="142dp"
            android:orientation="vertical"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvTitleRight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:textColor="#37474F"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:transitionName="property_title"
                    tools:text="FOREST SLATE VILLA" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/ivFilterPriceRight"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/ic_filter_indicator"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/tvPriceRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"
                        android:gravity="end"
                        tools:text="₹ 75,000" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvAmenitiesRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#546E7A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    tools:text="8 Amenities" />
                <TextView
                    android:id="@+id/tvInterestedRight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="8 Interested"
                    android:textColor="#546E7A"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvAreaRight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#616161"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    tools:text="2500 Sqft" />

                <TextView
                    android:id="@+id/tvBathRight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#616161"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    tools:text="3 BathRoom" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center">
                <ImageView
                    android:id="@+id/ivFilterLocationRight"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_filter_indicator"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/tvLocationRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:gravity="center"
                    android:textColor="#757575"
                    android:textSize="11sp"
                    tools:text="Civil Lines" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="start"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFacingRight"
                    style="@style/App.BhkTag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    tools:text="West" />

                <Space android:layout_width="4dp" android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvRoadSizeRight"
                    style="@style/App.BhkTag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    tools:text="60ft" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/ivFilterBhkRight"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/ic_filter_indicator"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/tvBhkRight"
                        style="@style/App.BhkTag"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        tools:text="4 BHK" />
                </LinearLayout>

                <Space android:layout_width="4dp" android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvFurnishedRight"
                    style="@style/App.BhkTag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    tools:text="Furnished" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>