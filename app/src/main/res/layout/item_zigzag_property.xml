<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp"
    android:layout_marginHorizontal="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Content for Left Image (Type A) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutLeft"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:id="@+id/bgCardLeft"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="60dp"
            android:background="@drawable/bg_zigzag_card"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardImageLeft"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardCornerRadius="60dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/ivPropertyLeft"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:transitionName="property_image"
                tools:src="@drawable/ic_app_logo" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/llMediaLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/cardImageLeft"
            app:layout_constraintStart_toStartOf="@id/cardImageLeft"
            app:layout_constraintEnd_toEndOf="@id/cardImageLeft">

            <TextView
                android:id="@+id/tvImgCountLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="•••"
                android:textSize="14sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivVideoIconLeft"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@android:drawable/ic_menu_slideshow"
                app:tint="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="122dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvPriceLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    android:gravity="start"
                    tools:text="₹ 28,000" />
                <TextView
                    android:id="@+id/tvTitleLeft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:transitionName="property_title"
                    tools:text="SKYLINE APARTMENT" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvInterestedLeft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="12 Interested"
                    android:textColor="#0D47A1"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="start" />
                <TextView
                    android:id="@+id/tvAmenitiesLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#0D47A1"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    tools:text="12 Amenities" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvBathLeft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    tools:text="2 BathRoom" />
                <TextView
                    android:id="@+id/tvBhkLeft"
                    style="@style/App.BhkTag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    tools:text="2 BHK" />
                <TextView
                    android:id="@+id/tvAreaLeft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    tools:text="1300 Sqft" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLocationLeft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:drawablePadding="2dp"
                android:gravity="start|center_vertical"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_location_pin"
                app:drawableTint="?attr/colorOnSurfaceVariant"
                tools:text="Model Town" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCallLeft"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Call"
                    android:textSize="10sp"
                    app:cornerRadius="8dp"
                    app:icon="@android:drawable/stat_sys_phone_call"
                    app:iconSize="14dp" />

                <Space android:layout_width="8dp" android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChatLeft"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Chat"
                    android:textSize="10sp"
                    app:cornerRadius="8dp"
                    app:icon="@android:drawable/stat_notify_chat"
                    app:iconSize="14dp" />

                <Space android:layout_width="8dp" android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStarLeft"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Star"
                    android:textSize="10sp"
                    app:cornerRadius="8dp"
                    app:icon="@android:drawable/btn_star"
                    app:iconSize="14dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Content for Right Image (Type B) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutRight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible">

        <View
            android:id="@+id/bgCardRight"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="60dp"
            android:background="@drawable/bg_zigzag_card_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardImageRight"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardCornerRadius="60dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/ivPropertyRight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:transitionName="property_image"
                tools:src="@drawable/ic_app_logo" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/llMediaRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/cardImageRight"
            app:layout_constraintStart_toStartOf="@id/cardImageRight"
            app:layout_constraintEnd_toEndOf="@id/cardImageRight">

            <TextView
                android:id="@+id/tvImgCountRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="•••"
                android:textSize="14sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivVideoIconRight"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@android:drawable/ic_menu_slideshow"
                app:tint="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="122dp"
            android:orientation="vertical"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvTitleRight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:transitionName="property_title"
                    tools:text="FOREST SLATE VILLA" />
                <TextView
                    android:id="@+id/tvPriceRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    tools:text="₹ 75,000" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvAmenitiesRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#0D47A1"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    tools:text="8 Amenities" />
                <TextView
                    android:id="@+id/tvInterestedRight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="8 Interested"
                    android:textColor="#0D47A1"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvAreaRight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    tools:text="2500 Sqft" />

                <TextView
                    android:id="@+id/tvBhkRight"
                    style="@style/App.BhkTag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    tools:text="4 BHK" />

                <TextView
                    android:id="@+id/tvBathRight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    tools:text="3 BathRoom" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLocationRight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:drawablePadding="2dp"
                android:gravity="end|center_vertical"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                app:drawableEndCompat="@drawable/ic_location_pin"
                app:drawableTint="?attr/colorOnSurfaceVariant"
                tools:text="Civil Lines" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="start"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCallRight"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Call"
                    android:textSize="10sp"
                    app:cornerRadius="8dp"
                    app:icon="@android:drawable/stat_sys_phone_call"
                    app:iconSize="14dp" />

                <Space android:layout_width="8dp" android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChatRight"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Chat"
                    android:textSize="10sp"
                    app:cornerRadius="8dp"
                    app:icon="@android:drawable/stat_notify_chat"
                    app:iconSize="14dp" />

                <Space android:layout_width="8dp" android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStarRight"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Star"
                    android:textSize="10sp"
                    app:cornerRadius="8dp"
                    app:icon="@android:drawable/btn_star"
                    app:iconSize="14dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>