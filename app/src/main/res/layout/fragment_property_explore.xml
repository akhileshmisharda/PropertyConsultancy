<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme1_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomActions"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpExploreMedia"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:transitionName="property_image" />
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabMediaDots"
                    android:layout_width="wrap_content"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="@android:color/transparent"
                    app:tabBackground="@drawable/dot_selector"
                    app:tabGravity="center"
                    app:tabIndicatorHeight="0dp"
                    app:tabMaxWidth="12dp"
                    app:tabRippleColor="@null" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvExploreTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/theme1_text"
                android:textSize="28sp"
                android:textStyle="bold"
                android:transitionName="property_title"
                tools:text="Skyline Apartment" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">
                <TextView
                    android:id="@+id/tvExplorePrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/theme2_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:transitionName="property_price"
                    tools:text="₹28,000/mo" />
                <TextView
                    android:id="@+id/tvExplorePropertyType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_zigzag_card"
                    android:textColor="#E53935"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:transitionName="property_type"
                    tools:text="APARTMENT" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#E0E0E0" />

            <TextView
                android:id="@+id/tvExploreLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:textColor="@color/theme1_text"
                android:textSize="16sp"
                android:transitionName="property_location"
                app:drawableStartCompat="@android:drawable/ic_menu_mylocation"
                tools:text="Model Town, Nagpur" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <TextView
                    android:id="@+id/tvExploreBhk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/theme1_text"
                    android:textSize="16sp"
                    android:transitionName="property_bhk"
                    tools:text="2 BHK" />

                <TextView
                    android:id="@+id/tvExploreArea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/theme1_text"
                    android:textSize="16sp"
                    android:transitionName="property_area"
                    tools:text="1300 sqft" />

                <TextView
                    android:id="@+id/tvExploreFacing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/theme1_text"
                    android:textSize="16sp"
                    android:transitionName="property_facing"
                    tools:text="Facing: East" />

                <TextView
                    android:id="@+id/tvExploreRoadSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/theme1_text"
                    android:textSize="16sp"
                    android:transitionName="property_roadsize"
                    tools:text="Road: 40ft" />

                <TextView
                    android:id="@+id/tvExploreFurnished"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:textColor="@color/theme1_text"
                    android:textSize="16sp"
                    android:transitionName="property_furnished"
                    tools:text="Furnished" />

                <TextView
                    android:id="@+id/tvExploreBath"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/theme1_text"
                    android:textSize="16sp"
                    android:transitionName="property_bath"
                    tools:text="2 Bathrooms" />

            </GridLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Description"
                android:textColor="@color/theme1_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExploreDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/theme1_text"
                android:textSize="15sp"
                tools:text="Beautiful apartment with city view and modern amenities. Located in the heart of the city." />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="16dp"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInterested"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="I'm Interested"
            app:cornerRadius="16dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
