<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme1_bg">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/exploreProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/exploreProgress">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpExploreMedia"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:transitionName="property_image" />
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabMediaDots"
                    android:layout_width="wrap_content"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="@android:color/transparent"
                    app:tabBackground="@drawable/dot_selector"
                    app:tabGravity="center"
                    app:tabIndicatorHeight="0dp"
                    app:tabMaxWidth="12dp"
                    app:tabRippleColor="@null" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvExploreTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/theme1_text"
                android:textSize="28sp"
                android:textStyle="bold"
                android:transitionName="property_title"
                tools:text="Skyline Apartment" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">
                <TextView
                    android:id="@+id/tvExplorePrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/theme2_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:transitionName="property_price"
                    tools:text="₹28,000/mo" />
                <TextView
                    android:id="@+id/tvExplorePropertyType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_zigzag_card"
                    android:textColor="#E53935"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:transitionName="property_type"
                    tools:text="APARTMENT" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#E0E0E0" />

            <TextView
                android:id="@+id/tvExploreLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:textColor="@color/theme1_text"
                android:textSize="16sp"
                android:transitionName="property_location"
                app:drawableStartCompat="@android:drawable/ic_menu_mylocation"
                tools:text="Model Town, Nagpur" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <TextView
                    android:id="@+id/tvExploreBhk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/theme1_text"
                    android:textSize="16sp"
                    android:transitionName="property_bhk"
                    tools:text="2 BHK" />

                <TextView
                    android:id="@+id/tvExploreArea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/theme1_text"
                    android:textSize="16sp"
                    android:transitionName="property_area"
                    tools:text="1300 sqft" />

                <TextView
                    android:id="@+id/tvExploreFacing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/theme1_text"
                    android:textSize="16sp"
                    android:transitionName="property_facing"
                    tools:text="Facing: East" />

                <TextView
                    android:id="@+id/tvExploreRoadSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/theme1_text"
                    android:textSize="16sp"
                    android:transitionName="property_roadsize"
                    tools:text="Road: 40ft" />

                <TextView
                    android:id="@+id/tvExploreFurnished"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:textColor="@color/theme1_text"
                    android:textSize="16sp"
                    android:transitionName="property_furnished"
                    tools:text="Furnished" />

                <TextView
                    android:id="@+id/tvExploreBath"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/theme1_text"
                    android:textSize="16sp"
                    android:transitionName="property_bath"
                    tools:text="2 Bathrooms" />

                <TextView
                    android:id="@+id/tvExploreAmenities"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textColor="#0D47A1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:transitionName="property_amenities"
                    tools:text="12 Amenities" />

                <TextView
                    android:id="@+id/tvExploreInterested"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:textColor="#0D47A1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:transitionName="property_interested"
                    tools:text="12 Interested" />

                <TextView
                    android:id="@+id/tvExploreFloor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/theme1_text"
                    android:textSize="16sp"
                    android:transitionName="property_floor"
                    tools:text="Floor: 2nd" />

            </GridLayout>

            <!-- Interaction Center -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTION CENTER"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/pending_gray"
                        android:letterSpacing="0.1" />

                    <!-- Part 1: Favorite -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="12dp">
                        <ImageView
                            android:id="@+id/ivFavoriteStatus"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_favorite_border"
                            android:contentDescription="Favorite Status" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="Mark as Favorite"
                            android:textColor="@color/theme1_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchFavorite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                    <!-- Part 2: Visit -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@android:drawable/ic_menu_my_calendar"
                                app:tint="@color/theme1_primary"
                                android:contentDescription="Visit Icon" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="Schedule a Visit"
                                android:textColor="@color/theme1_text"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEditVisit"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="Set Date"
                                android:textSize="11sp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvVisitCurrent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="40dp"
                            android:layout_marginTop="4dp"
                            android:text="No visit requested yet"
                            android:textSize="13sp"
                            android:textColor="@color/pending_gray" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

                    <!-- Part 3: Remarks -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_mic"
                                app:tint="@color/theme1_primary"
                                android:contentDescription="Remarks Icon" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="My Notes"
                                android:textColor="@color/theme1_text"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSaveRemarks"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="Save Notes"
                                app:icon="@drawable/ic_tick"
                                app:iconSize="14dp"
                                android:textSize="11sp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginStart="40dp"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            app:boxStrokeWidth="1dp"
                            app:boxStrokeColor="@color/pending_gray"
                            app:hintEnabled="false"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxBackgroundColor="#F9F9F9">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etExploreRemarks"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Type your property notes here..."
                                android:textSize="14sp"
                                android:minLines="3"
                                android:gravity="top"
                                android:background="@android:color/transparent"
                                android:textColor="@color/theme1_text"
                                android:padding="12dp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Description"
                android:textColor="@color/theme1_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExploreDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/theme1_text"
                android:textSize="15sp"
                tools:text="Beautiful apartment with city view and modern amenities. Located in the heart of the city." />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
