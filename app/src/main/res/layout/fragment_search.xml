<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme1_bg">

    <!-- Header Filter Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/filterCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Search Summary (Visible when filters are collapsed) -->
            <LinearLayout
                android:id="@+id/layoutSearchSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSearchSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Search results (0)"
                    android:textStyle="bold"
                    android:textColor="@color/theme1_text" />

                <TextView
                    android:id="@+id/tvPageSizeInfoSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="[ 5 Per Page ]"
                    android:textColor="#2196F3"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnToggleViewMode"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_location_pin"
                    app:tint="@color/theme1_primary" />

                <ImageButton
                    android:id="@+id/btnEditFilters"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_settings_modern"
                    app:tint="@color/theme1_primary" />
            </LinearLayout>

            <!-- Main Filter Content -->
            <LinearLayout
                android:id="@+id/layoutMainFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Mandatory City Search -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="@drawable/edit_text_bg"
                    android:paddingEnd="4dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@id/layoutSearchActions">
                        <AutoCompleteTextView
                            android:id="@+id/etSearchCity"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="Search City..."
                            android:inputType="text"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:completionThreshold="1"
                            android:textColor="@color/theme1_text"
                            android:textSize="14sp" />
                        <ImageView
                            android:id="@+id/ivFilterCity"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_gravity="start|top"
                            android:layout_marginTop="4dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_filter_indicator"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/layoutSearchActions"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnAiFilter"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_btn_speak_now"
                            app:tint="@color/theme1_primary" />

                        <TextView
                            android:id="@+id/tvPageSizeInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:text="[ 5 Per Page ]"
                            android:textColor="#2196F3"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDoSearch"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginEnd="4dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Apply"
                            android:textSize="10sp"
                            android:textAllCaps="false"
                            app:cornerRadius="6dp" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Favourite Cities -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupFavCities"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true" />
                </HorizontalScrollView>

                <!-- Top Filters (Visible when advanced is hidden) -->
                <LinearLayout
                    android:id="@+id/layoutTopFilters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPriceFilterHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_filter"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Any Price"
                        android:textSize="12sp"
                        android:textColor="@color/theme1_text"/>

                    <Space android:layout_width="8dp" android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvBedsFilterHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_filter"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Any Beds"
                        android:textSize="12sp"
                        android:textColor="@color/theme1_text"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvToggleFilters"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="4dp"
                        android:text="Show Filters ▼"
                        android:textColor="@color/theme1_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnClearFilters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="Clear All"
                        android:textColor="@color/error_red"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Fold 1: Basic Filters -->
                <LinearLayout
                    android:id="@+id/layoutFold1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#F0F0F0" />

                    <!-- Row 1: Price Range -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etMinPrice"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Min Price"
                                    android:inputType="number" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <ImageView
                                android:id="@+id/ivFilterMinPrice"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="start|top"
                                android:layout_marginTop="8dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_filter_indicator"
                                android:visibility="gone" />
                        </FrameLayout>
                        <Space android:layout_width="12dp" android:layout_height="wrap_content" />
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etMaxPrice"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Max Price"
                                    android:inputType="number" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <ImageView
                                android:id="@+id/ivFilterMaxPrice"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="start|top"
                                android:layout_marginTop="8dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_filter_indicator"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Row 2: Beds & Baths -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etBedrooms"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Beds"
                                    android:inputType="number" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <ImageView
                                android:id="@+id/ivFilterBedrooms"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="start|top"
                                android:layout_marginTop="8dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_filter_indicator"
                                android:visibility="gone" />
                        </FrameLayout>
                        <Space android:layout_width="12dp" android:layout_height="wrap_content" />
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etBathrooms"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Baths"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <ImageView
                                android:id="@+id/ivFilterBathrooms"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="start|top"
                                android:layout_marginTop="8dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_filter_indicator"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvToggleFold2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:padding="4dp"
                        android:text="Advanced Selection ▼"
                        android:textColor="@color/theme1_primary"
                        android:textSize="12sp" />

                    <!-- Fold 2: Advanced Selection -->
                    <LinearLayout
                        android:id="@+id/layoutFold2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="#F0F0F0" />

                        <!-- Row 3: Floor & Facing (2 in 1 Row) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                        android:id="@+id/etFilterFloor"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="Floor"
                                        android:focusable="false"
                                        android:clickable="true" />
                                </com.google.android.material.textfield.TextInputLayout>
                                <ImageView
                                    android:id="@+id/ivFilterFloor"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_gravity="start|top"
                                    android:layout_marginTop="8dp"
                                    android:layout_marginStart="8dp"
                                    android:src="@drawable/ic_filter_indicator"
                                    android:visibility="gone" />
                            </FrameLayout>
                            <Space android:layout_width="12dp" android:layout_height="wrap_content" />
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                        android:id="@+id/etFilterFacing"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="Facing"
                                        android:focusable="false"
                                        android:clickable="true" />
                                </com.google.android.material.textfield.TextInputLayout>
                                <ImageView
                                    android:id="@+id/ivFilterFacing"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_gravity="start|top"
                                    android:layout_marginTop="8dp"
                                    android:layout_marginStart="8dp"
                                    android:src="@drawable/ic_filter_indicator"
                                    android:visibility="gone" />
                            </FrameLayout>
                        </LinearLayout>

                        <!-- Row 4: Road Size & Type (2 in 1 Row) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal">
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                        android:id="@+id/etFilterRoadSize"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="Road"
                                        android:focusable="false"
                                        android:clickable="true" />
                                </com.google.android.material.textfield.TextInputLayout>
                                <ImageView
                                    android:id="@+id/ivFilterRoadSize"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_gravity="start|top"
                                    android:layout_marginTop="8dp"
                                    android:layout_marginStart="8dp"
                                    android:src="@drawable/ic_filter_indicator"
                                    android:visibility="gone" />
                            </FrameLayout>
                            <Space android:layout_width="12dp" android:layout_height="wrap_content" />
                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                        android:id="@+id/etFilterProType"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="Type"
                                        android:focusable="false"
                                        android:clickable="true" />
                                </com.google.android.material.textfield.TextInputLayout>
                                <ImageView
                                    android:id="@+id/ivFilterProType"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_gravity="start|top"
                                    android:layout_marginTop="8dp"
                                    android:layout_marginStart="8dp"
                                    android:src="@drawable/ic_filter_indicator"
                                    android:visibility="gone" />
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/searchProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/filterCard" />

    <!-- Container for both List and Map -->
    <FrameLayout
        android:id="@+id/layoutContentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@id/layoutPagination"
        app:layout_constraintTop_toBottomOf="@id/searchProgress">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="4dp"
            android:visibility="visible" />

        <FrameLayout
            android:id="@+id/layoutMapContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <fragment
                android:id="@+id/mapResults"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Map Marker Detail Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMapProperty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="12dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="15dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/theme1_bg"
                    android:padding="4dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutZigzagPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:clipChildren="false">

                        <View
                            android:id="@+id/bgCardPopup"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_marginStart="60dp"
                            android:background="@drawable/bg_zigzag_card"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvMapPropertyType"
                            style="@style/App.BhkTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="4dp"
                            android:textSize="12sp"
                            android:textColor="#E53935"
                            android:layout_marginBottom="4dp"
                            app:layout_constraintBottom_toTopOf="@id/cardMapImage"
                            app:layout_constraintStart_toStartOf="@id/cardMapImage"
                            app:layout_constraintEnd_toEndOf="@id/cardMapImage"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintVertical_chainStyle="packed"
                            tools:text="APARTMENT" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardMapImage"
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            android:layout_marginStart="8dp"
                            app:cardCornerRadius="55dp"
                            app:cardElevation="8dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="?attr/colorPrimary"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvMapPropertyType">
                            <ImageView
                                android:id="@+id/ivMapProperty"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                tools:src="@drawable/ic_app_logo" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="122dp"
                            android:layout_marginEnd="12dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <TextView
                                    android:id="@+id/tvMapPropertyPrice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="?attr/colorPrimary"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:text="₹ 28,000" />
                                <TextView
                                    android:id="@+id/tvMapPropertyTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    tools:text="SKYLINE APARTMENT" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/tvMapPropertyBath"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    tools:text="2 Bath" />
                                <TextView
                                    android:id="@+id/tvMapPropertyArea"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    tools:text="1300 Sqft" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvMapPropertyLocation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="11sp"
                                tools:text="Model Town, Mumbai" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/tvMapPropertyBhk"
                                    style="@style/App.BhkTag"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textSize="10sp"
                                    android:gravity="center"
                                    tools:text="2 BHK" />
                                <Space android:layout_width="4dp" android:layout_height="wrap_content" />
                                <TextView
                                    android:id="@+id/tvMapPropertyFacing"
                                    style="@style/App.BhkTag"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textSize="10sp"
                                    android:gravity="center"
                                    tools:text="East" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMapExplore"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="32dp"
                                android:layout_marginTop="6dp"
                                android:text="Explore Property"
                                android:textSize="10sp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="8dp" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ImageButton
                        android:id="@+id/btnMapCloseCard"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="@color/pending_gray" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Discover your unique rental..."
            android:textColor="@color/pending_gray"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Pagination Controls (Overlays RecyclerView) -->
    <LinearLayout
        android:id="@+id/layoutPagination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp"
        android:paddingTop="12dp"
        android:background="#BFF0F4FF"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/layoutPageNumbers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Animated HUD Hint Popups -->
    <ImageView
        android:id="@+id/ivHudHintCenter"
        android:layout_width="400dp"
        android:layout_height="200dp"
        android:visibility="gone"
        android:alpha="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/ivHudHintBottom"
        android:layout_width="400dp"
        android:layout_height="150dp"
        android:layout_marginBottom="60dp"
        android:visibility="gone"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <!-- Sticky Fragment Hints -->
    <ImageView
        android:id="@+id/ivHintStickyAi"
        android:layout_width="400dp"
        android:layout_height="200dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivHintStickyFilter"
        android:layout_width="400dp"
        android:layout_height="200dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivHintStickyViewMode"
        android:layout_width="400dp"
        android:layout_height="200dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivHintStickySwipeLeft"
        android:layout_width="400dp"
        android:layout_height="200dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivHintStickySwipeRight"
        android:layout_width="400dp"
        android:layout_height="200dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivSwipeHintLeft"
        android:layout_width="250dp"
        android:layout_height="150dp"
        android:visibility="gone"
        android:alpha="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible"
        tools:src="@drawable/ic_app_logo" />

    <ImageView
        android:id="@+id/ivSwipeHintRight"
        android:layout_width="250dp"
        android:layout_height="150dp"
        android:visibility="gone"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible"
        tools:src="@drawable/ic_app_logo" />

</androidx.constraintlayout.widget.ConstraintLayout>
